# Backend API Configuration
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log format: json or simple
LOG_FORMAT=json

# Rate Limiting
# Requests per window
RATE_LIMIT_REQUESTS=100
# Window in seconds
RATE_LIMIT_WINDOW=60

# File I/O Retry Configuration
# Maximum retry attempts for file operations
FILE_IO_MAX_RETRIES=3
# Base delay in seconds for exponential backoff
FILE_IO_BACKOFF_BASE=0.1

# Frontend API Configuration (used by Vite)
# Uncomment and set if different from default
# VITE_API_BASE_URL=http://localhost:8000
